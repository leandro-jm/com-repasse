# SPA (fallback p/ index.html) + proxy same-origin de /api → backend Hono.
# ${API_UPSTREAM} é substituído no start pelo entrypoint do nginx (envsubst).
server {
  listen       80;
  server_name  _;

  # Resolver do Docker: re-resolve o upstream em runtime, então sobrevive à
  # recriação do container `api` (IP novo) sem precisar recarregar o nginx.
  resolver 127.0.0.11 valid=10s ipv6=off;

  root   /usr/share/nginx/html;
  index  index.html;

  # uploads (fotos de negócio / anexos / PDF) passam por este proxy
  client_max_body_size 25m;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # healthcheck do próprio container web
  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  # API na mesma origem: /api/* → backend, SEM o prefixo /api.
  #   /api/auth/login  ->  http://api:8787/auth/login
  location /api/ {
    set $api_upstream ${API_UPSTREAM};
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }

  # assets com hash no nome: cache longo e imutável
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # SPA: qualquer outra rota (inclui /carro/:id e /sair/:id) cai no index.html
  location / {
    try_files $uri $uri/ /index.html;
  }
}
