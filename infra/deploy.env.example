# Stack de produção (infra/docker-compose.yml). Copie para infra/.env e preencha.
# No Portainer, use estes mesmos nomes no formulário de variáveis do stack.

# ── Registry privado / imagens ───────────────────────────────────────────────
REGISTRY=31.220.95.65:5000      # host:porta do registry privado (HTTP/inseguro)
IMAGE_TAG=latest
WEB_PORT=8080                   # porta pública do web (nginx). Atrás de proxy TLS, exponha só a rede interna.

# ── Supabase (Cloud) ─────────────────────────────────────────────────────────
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key   # só backend/worker; nunca no front

# ── App ──────────────────────────────────────────────────────────────────────
# URL pública do web. A MESMA origem serve o /api. Usada em CORS e nos links de
# campanha / opt-out gerados pelo worker (ex.: .../carro/:id, .../sair/:id).
WEB_ORIGIN=https://crm.seudominio.com.br
PUBLIC_APP_URL=https://crm.seudominio.com.br

# Cifra de segredos em repouso (api_key do WhatsApp) — API e worker.
# Valor forte e único; trocar a chave invalida segredos já cifrados. OBRIGATÓRIA.
APP_ENCRYPTION_KEY=troque-por-uma-chave-forte-e-unica

# ── Billing (camada abstraída) ───────────────────────────────────────────────
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=defina-um-segredo-para-o-webhook

# ── Worker (throttling de envio, ms) ─────────────────────────────────────────
CAMPAIGN_THROTTLE_MIN_MS=4000
CAMPAIGN_THROTTLE_MAX_MS=12000

# ── Interno (raramente muda) ─────────────────────────────────────────────────
# upstream da API para o proxy do nginx dentro da rede do compose
# API_UPSTREAM=http://api:8787
