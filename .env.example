# =============================================================================
# Arquitetura: front (apps/web) → backend (apps/api) → Supabase.
# O front NÃO fala com o Supabase direto — só conhece a URL da API.
# A config do Evolution é por tenant (tabela whatsapp_instances), não aqui.
# =============================================================================

# --- App web (Vite: precisa do prefixo VITE_) ---
# apps/web/.env
VITE_API_URL=http://localhost:8787

# --- Backend API (apps/api) ---
API_PORT=8787
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key
WEB_ORIGIN=http://localhost:5173          # origem(ns) do front p/ CORS (separadas por vírgula)
PUBLIC_APP_URL=http://localhost:5173      # base do link "mais detalhes" da campanha

# --- Worker de campanhas (apps/worker) — service role, só backend ---
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
CAMPAIGN_THROTTLE_MIN_MS=4000
CAMPAIGN_THROTTLE_MAX_MS=12000

# Cifra de segredos em repouso (api_key do WhatsApp) — API e worker.
# Use um valor forte e único; trocar a chave invalida segredos já cifrados.
APP_ENCRYPTION_KEY=troque-por-uma-chave-forte-e-unica

# Billing (camada abstraída). manual = sem gateway externo.
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=defina-um-segredo-para-o-webhook
